# Copy to .env to override defaults. The demo needs none of these to run.

# Port the Rails server listens on.
PORT=3400

# Public base URL, used in links inside messages.
PUBLIC_URL=http://localhost:3400

# Hours until a sign-in session expires.
SESSION_TTL_HOURS=12

# Outgoing mail limit: a burst of this many messages, refilled at this many per second.
MAIL_BURST=5
MAIL_PER_SECOND=1

# Production only: the secret that signs unsubscribe links.
# Generate one with: cd src/api && bin/rails secret
# Leave it unset in the container to have one generated and stored in the data volume.
SECRET_KEY_BASE=
